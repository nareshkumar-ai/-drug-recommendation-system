# LLM Provider: 'gemini' for cloud deployment, 'ollama' for local development
LLM_PROVIDER=gemini

# Google Gemini API Key (obtained from Google AI Studio at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Web Server Port (automatically set by Render in production)
PORT=5000
